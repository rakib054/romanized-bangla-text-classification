{
  "dataset": {
    "raw_dir": "Datasets",
    "train_file": "train.csv",
    "test_file": "test.csv",
    "sample_sub_file": "sample_submission.csv",
    "text_col": "text",
    "id_col": "id",
    "label_col": "label"
  },
  "text_cleaning": {
    "unicode_normalization": "NFKD",
    "lowercase": true,
    "strip_urls": false,
    "normalize_repeated_chars": true,
    "repeated_char_threshold": 2,
    "preserve_hyphenated_suffixes": true,
    "normalize_whitespace": true
  },
  "numerical_features": {
    "enabled": true,
    "compute_ratios": true,
    "flag_special_patterns": true
  },
  "word_tfidf": {
    "enabled": true,
    "ngram_range": [1, 2],
    "max_features": 15000,
    "min_df": 2,
    "max_df": 0.85,
    "sublinear_tf": true,
    "token_pattern": "(?u)\\b[a-zA-Z]+(?:-[a-zA-Z]+)?\\b"
  },
  "char_tfidf": {
    "enabled": true,
    "analyzer": "char_wb",
    "ngram_range": [3, 5],
    "max_features": 35000,
    "min_df": 3,
    "sublinear_tf": true
  },
  "export": {
    "output_dir": "Featured Dataset",
    "save_processed_text": true,
    "save_numerical_features": true,
    "save_sparse_matrices": true,
    "save_combined_features": true
  }
}

